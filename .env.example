# Yerelde .env.local olarak kopyalayın. Canlıda Coolify ortam değişkenleri.

# Sitenin tam adresi (paylaşım görseli, site haritası, ürün yapılandırılmış verisi).
SITE_ADRESI=https://nfcqrkartimcom.ahmcloud.com

# Yönetim paneli (/yonetim) şifresi. En az 8 karakter; boşsa panel kapalıdır.
YONETICI_SIFRE=

# Çerez imzalama anahtarı, en az 32 karakter. Örnek üretim: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Boş bırakılırsa ilk açılışta üretilip veritabanında saklanır.
OTURUM_GIZLI=

# Veritabanı klasörü (yerelde ./veri). Docker'da /veri.
# VERI_KOKU=

# Arama motorlarına açmak için 1 (demo alt alanında 0 kalsın).
ARAMA_MOTORU_ACIK=0

# Kartla ödeme (iyzico). Üçü de doluysa ödeme sayfasında "Kredi / banka kartı" seçeneği çıkar.
# Deneme: https://sandbox-api.iyzipay.com (anahtarlar sandbox-merchant.iyzipay.com'dan)
# Canlı:  https://api.iyzipay.com          (anahtarlar merchant.iyzipay.com › Ayarlar)
# Yerelde sahte sunucuyla: node scripts/iyzico-sahte.mjs → IYZICO_ADRES=http://localhost:3999,
#   IYZICO_API_KEY=sahte-anahtar, IYZICO_SECRET_KEY=sahte-gizli
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_ADRES=
